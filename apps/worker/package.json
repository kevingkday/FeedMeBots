{
  "name": "@feedmebots/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FeedMeBots on Cloudflare Workers, Durable Objects, and D1",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply feedmebots-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply feedmebots-db --remote",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@feedmebots/engine": "workspace:*",
    "hono": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240903.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.2"
  }
}
